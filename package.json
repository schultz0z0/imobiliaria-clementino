{
  "name": "imobiliaria-clementino-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4174 --host 0.0.0.0",
    "build": "vite build && npm run seo:prerender",
    "admin:dev": "vite --config admin/vite.config.ts --host 0.0.0.0",
    "admin:build": "vite build --config admin/vite.config.ts",
    "server:dev": "tsx watch server/api/index.ts",
    "server:build": "esbuild server/api/index.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist-server/api/index.js",
    "publisher:build": "esbuild server/publisher/index.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist-server/publisher/index.js",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:test": "node --env-file=server/db/test.env --import tsx server/db/migrate.ts --test-database",
    "test:db": "node --env-file=server/db/test.env --import tsx --test server/db/*.integration.test.ts",
    "test:auth": "node --env-file=server/db/test.env --import tsx --test server/auth/*.test.ts",
    "db:seed-admin": "tsx scripts/admin/seedAdmin.ts",
    "db:reset-admin-password": "tsx scripts/admin/resetAdminPassword.ts",
    "publisher:run": "tsx server/publisher/index.ts",
    "backup:run": "tsx scripts/operations/backup.ts",
    "restore:verify": "tsx scripts/operations/verifyBackup.ts",
    "migrate:legacy": "tsx scripts/migration/importLegacyCatalog.ts",
    "test:e2e": "playwright test",
    "test:public-performance": "playwright test -c playwright.public.config.ts",
    "performance:site": "tsx scripts/performance/publicSitePerformance.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "media:typecheck": "tsc --noEmit -p tsconfig.media.json",
    "test": "tsx --test src/**/*.test.ts scripts/**/*.test.ts",
    "catalog:generate": "tsx scripts/catalog/generateCatalog.ts --write",
    "catalog:verify": "tsx scripts/catalog/generateCatalog.ts --verify",
    "catalog:images": "tsx scripts/catalog/generateImages.ts",
    "seo:generate": "tsx scripts/seo/generateSeo.ts --public",
    "seo:prerender": "tsx scripts/seo/generateSeo.ts --dist",
    "predev": "npm run catalog:verify && npm run catalog:images && npm run seo:generate",
    "prebuild": "npm run catalog:verify && npm run catalog:images && npm run seo:generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.45.1",
    "fastify": "^5.12.1",
    "file-type": "^22.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.14.1",
    "sharp": "^0.35.4",
    "vite": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
