COMPOSE_PROJECT_NAME=imobiliaria-clementino
DOMAIN=clementinoimoveis.com.br
# Preencha quando a propriedade GA4 existir (ex: G-XXXXXXXXXX). Sem um ID G-... nenhuma tag é carregada.
VITE_GA_MEASUREMENT_ID=
# Preencha quando configurar campanhas do Google Ads (ex: AW-XXXXXXXXXX).
VITE_GOOGLE_ADS_ID=
# Identificador público do Meta Pixel. Valor explicitamente vazio desativa a integração.
VITE_META_PIXEL_ID=1324132266370583
# Preencha com o código de verificação do Google Search Console (se usar verificação por meta tag).
VITE_GOOGLE_SITE_VERIFICATION=
POSTGRES_DB=clementino
POSTGRES_USER=clementino
POSTGRES_PASSWORD=change-this-before-deploy
DATABASE_URL=postgresql://clementino:change-this-before-deploy@postgres:5432/clementino
ADMIN_DOMAIN=admin.clementinoimoveis.com.br
PREVIEW_TOKEN_SECRET=generate-a-random-secret-with-at-least-32-characters
LOCATION_PRIVACY_SECRET=generate-a-random-secret-with-at-least-32-characters
PUBLISHED_ROOT=/data/published
# Geocodificação gratuita via Nominatim/OpenStreetMap (sem chave de API).
NOMINATIM_USER_AGENT=Imobiliaria Clementino/1.0 (+https://clementinoimoveis.com.br)
